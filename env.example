# Groq — free key from https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-20b
LLM_BACKEND=groq

# Knowledge base
CHUNKS_PATH=./chunks.json

# Vector store: memory | chroma | pgvector
VECTOR_STORE=memory

# Retrieval tuning
RELEVANCE_FLOOR=0.55
TOP_K=3
FUZZY_MIN_SCORE=78

# Set to 1 to print LLM errors instead of falling back silently
DEBUG_LLM=1
